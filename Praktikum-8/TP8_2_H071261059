import re
def validasi_username(username):
    return re.match(r"^[a-zA-Z]\w{4,11}$", username)

username_valid =[]

while True:
    username = input("masukkan username (ketik'selesai'untuk mengakhiri): ").lower()
    if username == "selesai":
        break
    if validasi_username(username):
        print("Username tersedia\n")
        username_valid.append(username)
    else:
        print("Username tidak valid\n")  

print("\n---rekapitulasi---")
print("username valid: ")
nomor = 1
for username in username_valid:
    print(f"{nomor}. {username}")
    nomor += 1

print("\njumlah username valid: ", len(username_valid))
    